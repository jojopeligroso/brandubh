{
  "name": "brandubh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A slick, playable Brandubh (Irish 7x7 hnefatafl) board game with two rule variants and an AI opponent.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "npm run build && node scripts/screenshot.mjs",
    "check:evalbar": "npm run build && node scripts/evalbar-geometry.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}
